# ============================================================
# JobTracker Environment Configuration Template
# Generate secret keys with: python scripts/generate_keys.py
# ============================================================

# --- Core Cryptographic Keys (Required) ---
APP_SECRET_KEY=
FERNET_KEY=

# --- JWT Auth Configuration ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database & Storage (MongoDB Atlas / Local / Render) ---
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# For Local Development: mongodb://localhost:27017
APP_DB_URI=mongodb://localhost:27017
APP_DB_NAME=jobtracker

# --- Admin Account (Initialized on first boot) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Security & HTTP Settings ---
# In production (e.g., Vercel or HTTPS), set COOKIE_SECURE=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=10
